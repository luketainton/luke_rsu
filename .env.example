PORT=8000
APP_URL=https://rsu.example.net
ALLOWED_HOSTS=rsu.example.net
CSRF_TRUSTED_ORIGINS=https://rsu.example.net
POSTGRES_PASSWORD=replace-with-a-long-random-password
DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret
# Leave blank to use local Django accounts only. Set all three for company SSO.
OIDC_ISSUER_URL=https://id.example.net/application/o/rsu/
OIDC_CLIENT_ID=rsu-ledger
OIDC_CLIENT_SECRET=replace-me
# Optional: enables SCIM 2.0 at /scim/v2/ with a dedicated bearer token.
SCIM_BEARER_TOKEN=replace-with-a-long-random-provisioning-token
# Optional: enables retrieval of Wise historical GBP/USD rates. Never commit a real token.
WISE_PERSONAL_API_TOKEN=
